{
  "name": "jade-healing-spa",
  "version": "0.1.0",
  "private": true,
  "description": "Informational website for Jade Healing Spa. No booking in the first version.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "smoke:local": "LOCAL_SMOKE=1 PLAYWRIGHT_BROWSERS_PATH=\"${HOME}/Library/Caches/ms-playwright\" playwright test tests/local-smoke.spec.ts --project=chromium",
    "research:verify": "PLAYWRIGHT_BROWSERS_PATH=\"${HOME}/Library/Caches/ms-playwright\" playwright test tests/verify-playwright.spec.ts --project=chromium",
    "verify:playwright": "npm run research:verify",
    "research:nhaspa": "PLAYWRIGHT_BROWSERS_PATH=\"${HOME}/Library/Caches/ms-playwright\" playwright test tests/research-nhaspa.spec.ts --project=chromium",
    "research:nhaspa:followup": "PLAYWRIGHT_BROWSERS_PATH=\"${HOME}/Library/Caches/ms-playwright\" playwright test tests/research-nhaspa-followup.spec.ts --project=chromium",
    "research:scroll": "PLAYWRIGHT_BROWSERS_PATH=\"${HOME}/Library/Caches/ms-playwright\" playwright test tests/research-scroll-capture.spec.ts --project=chromium",
    "test": "PLAYWRIGHT_BROWSERS_PATH=\"${HOME}/Library/Caches/ms-playwright\" playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
